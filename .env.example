# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Telegram: токен от @BotFather и ID чата (узнать можно у @userinfobot)
ECOWATCH_TG_TOKEN=
ECOWATCH_TG_CHAT_ID=

# Координаты камеры — для карты инцидентов (необязательно)
ECOWATCH_CAMERA_LAT=
ECOWATCH_CAMERA_LON=

# Необязательно: путь к модели, папка данных, устройство (cpu / 0 для GPU)
# ECOWATCH_MODEL=models/best.pt
# ECOWATCH_DATA_DIR=data
# ECOWATCH_DEVICE=0
